        <mxCell id="cm1" value="1. Click &quot;Confirm Order&quot; (PROCESSING)" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="70" y="145" as="sourcePoint" /><mxPoint x="330" y="145" as="targetPoint" /></mxGeometry></mxCell>
