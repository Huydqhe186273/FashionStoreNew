<mxCell id="p1_n23" value="recommendationService.js&lt;br&gt;GET /api/recommendations/&lt;br&gt;personalized?limit=8&amp;amp;sessionId=…" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;align=center;" parent="1" vertex="1"><mxGeometry x="335" y="585" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="p1_n24" value="&lt;b&gt;RecommendationController&lt;/b&gt;&lt;br&gt;userId từ JWT · kẹp limit 1–30" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;align=center;" parent="1" vertex="1"><mxGeometry x="605" y="590" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="p1_n25" value="&lt;b&gt;UserPreferenceService&lt;/b&gt;&lt;br&gt;.getPreferences(userId, sessionId)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;align=center;" parent="1" vertex="1"><mxGeometry x="605" y="690" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="p1_db26" value="&lt;b&gt;SELECT&lt;/b&gt; ≤ 100 log / 30 ngày&lt;br&gt;UserId = user OR&lt;br&gt;SessionId = phiên hiện tại" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1215" y="685" width="230" height="80" as="geometry"/></mxCell>
<mxCell id="p1_n27" value="&lt;b&gt;Quy điểm từng hành vi&lt;/b&gt;&lt;br&gt;click 2 · view 0/2/5/8 · giỏ 6 · ❤ 10 · mua 12&lt;br&gt;Cộng dồn → top 5 danh mục, màu, size&lt;br&gt;Khoảng giá = min – max" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;align=center;" parent="1" vertex="1"><mxGeometry x="595" y="800" width="320" height="90" as="geometry"/></mxCell>
<mxCell id="p1_d28" value="Có hồ sơ&lt;br&gt;sở thích?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=1.5;fontSize=12;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="680" y="935" width="150" height="90" as="geometry"/></mxCell>
<mxCell id="p1_n29" value="&lt;b&gt;Cold-start&lt;/b&gt;&lt;br&gt;Xen kẽ bán chạy + hàng mới&lt;br&gt;(bỏ SP đã mua)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;align=center;" parent="1" vertex="1"><mxGeometry x="910" y="945" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="p1_db30" value="&lt;b&gt;SELECT&lt;/b&gt; SP đã mua (bỏ đơn huỷ)&lt;br&gt;SP active thuộc top danh mục&lt;br&gt;+ variant (màu, size, tồn kho)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1215" y="1060" width="230" height="85" as="geometry"/></mxCell>
<mxCell id="p1_n31" value="Lọc: bỏ SP &lt;b&gt;đã mua&lt;/b&gt;, SP &lt;b&gt;hết hàng&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;align=center;" parent="1" vertex="1"><mxGeometry x="605" y="1070" width="300" height="55" as="geometry"/></mxCell>
<mxCell id="p1_n32" value="&lt;b&gt;scoreProduct()&lt;/b&gt;&lt;br&gt;Danh mục hạng 1→5: 50/40/30/20/10&lt;br&gt;Giá trong khoảng 25 · lệch ≤25% 15&lt;br&gt;Màu 15 · Size 10 · Phổ biến ≤ 15&lt;br&gt;→ Sắp xếp giảm dần, lấy top N" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;align=center;" parent="1" vertex="1"><mxGeometry x="595" y="1170" width="320" height="105" as="geometry"/></mxCell>
<mxCell id="p1_d33" value="Đủ N&lt;br&gt;sản phẩm?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=1.5;fontSize=12;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="680" y="1320" width="150" height="90" as="geometry"/></mxCell>
<mxCell id="p1_n34" value="Bù bằng cold-start&lt;br&gt;(không trùng SP đã chọn)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;align=center;" parent="1" vertex="1"><mxGeometry x="910" y="1330" width="230" height="60" as="geometry"/></mxCell>
