# Fashion Store - Environment Variables Template
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control!

# =========================================================
# Database (SQL Server)
# Default: jdbc:sqlserver://localhost;databaseName=FashionStoreDB;encrypt=true;trustServerCertificate=true
# Windows Auth (Thuấn): jdbc:sqlserver://localhost:6985;databaseName=FashionStoreDB;encrypt=true;trustServerCertificate=true;integratedSecurity=true;sendStringParametersAsUnicode=true;characterEncoding=UTF-8
# =========================================================
DB_URL=jdbc:sqlserver://localhost;databaseName=FashionStoreDB;encrypt=true;trustServerCertificate=true;sendStringParametersAsUnicode=true;characterEncoding=UTF-8;stringtype=nvarchar;
DB_USERNAME=sa
DB_PASSWORD=sa

# =========================================================
# Email (Gmail SMTP)
# =========================================================
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# =========================================================
# PayOS Payment Gateway
# =========================================================
PAYOS_CLIENT_ID=your-client-id
PAYOS_API_KEY=your-api-key
PAYOS_CHECKSUM_KEY=your-checksum-key
