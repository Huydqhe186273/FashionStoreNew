CREATE DATABASE FashionStoreDB;
GO
USE FashionStoreDB;
GO

/* ============================================================
   1. TÀI KHOẢN & PHÂN QUYỀN
   ============================================================ */

CREATE TABLE Users (
    UserId          INT IDENTITY(1,1) PRIMARY KEY,
    FullName        NVARCHAR(150) NOT NULL,
    Email           NVARCHAR(150) NOT NULL UNIQUE,
    PasswordHash    NVARCHAR(255) NOT NULL,
    Phone           NVARCHAR(20)  NULL,
    Role            NVARCHAR(20)  NOT NULL DEFAULT 'customer'
                    CHECK (Role IN ('customer','staff','admin')),
    Status          NVARCHAR(20)  NOT NULL DEFAULT 'active'
                    CHECK (Status IN ('active','locked')),
    CreatedAt       DATETIME2     NOT NULL DEFAULT SYSDATETIME()
);
GO

CREATE TABLE Addresses (
    AddressId       INT IDENTITY(1,1) PRIMARY KEY,
    UserId          INT NOT NULL,
    RecipientName   NVARCHAR(150) NOT NULL,
    Phone           NVARCHAR(20)  NOT NULL,
    AddressLine     NVARCHAR(255) NOT NULL,
    City            NVARCHAR(100) NOT NULL,
    IsDefault       BIT NOT NULL DEFAULT 0,
    CONSTRAINT FK_Addresses_Users FOREIGN KEY (UserId) REFERENCES Users(UserId)
);
GO

/* ============================================================
   2. SẢN PHẨM
   ============================================================ */

CREATE TABLE Categories (
    CategoryId      INT IDENTITY(1,1) PRIMARY KEY,
    Name            NVARCHAR(100) NOT NULL,
    ParentId        INT NULL,
    Gender          NVARCHAR(20)  NULL CHECK (Gender IN ('nam','nu','unisex')),
    Season          NVARCHAR(20)  NULL,
    CONSTRAINT FK_Categories_Parent FOREIGN KEY (ParentId) REFERENCES Categories(CategoryId)
);
GO

CREATE TABLE Products (
    ProductId       INT IDENTITY(1,1) PRIMARY KEY,
    CategoryId      INT NOT NULL,
    Name            NVARCHAR(200) NOT NULL,
    Description     NVARCHAR(MAX) NULL,
    BasePrice       DECIMAL(12,0) NOT NULL,
    DiscountPrice   DECIMAL(12,0) NULL,
    Status          NVARCHAR(20)  NOT NULL DEFAULT 'active'
                    CHECK (Status IN ('active','inactive')),
    ViewCount       INT NOT NULL DEFAULT 0,
    SoldCount       INT NOT NULL DEFAULT 0,
    CreatedAt       DATETIME2     NOT NULL DEFAULT SYSDATETIME(),
    CONSTRAINT FK_Products_Categories FOREIGN KEY (CategoryId) REFERENCES Categories(CategoryId)
);
GO

CREATE TABLE ProductVariants (
    VariantId       INT IDENTITY(1,1) PRIMARY KEY,
    ProductId       INT NOT NULL,
    Size            NVARCHAR(20) NOT NULL,
    Color           NVARCHAR(50) NOT NULL,
    StockQuantity   INT NOT NULL DEFAULT 0,
    Sku             NVARCHAR(50) NOT NULL UNIQUE,
    CONSTRAINT FK_Variants_Products FOREIGN KEY (ProductId) REFERENCES Products(ProductId)
);
GO

CREATE TABLE ProductImages (
    ImageId         INT IDENTITY(1,1) PRIMARY KEY,
    ProductId       INT NOT NULL,
    ImageUrl        NVARCHAR(500) NOT NULL,
    IsPrimary       BIT NOT NULL DEFAULT 0,
    CONSTRAINT FK_Images_Products FOREIGN KEY (ProductId) REFERENCES Products(ProductId)
);
GO

/* ============================================================
   3. GIỎ HÀNG & ĐƠN HÀNG
   ============================================================ */

CREATE TABLE Carts (
    CartId          INT IDENTITY(1,1) PRIMARY KEY,
    UserId          INT NOT NULL UNIQUE,
    CONSTRAINT FK_Carts_Users FOREIGN KEY (UserId) REFERENCES Users(UserId)
);
GO

CREATE TABLE CartItems (
    CartItemId      INT IDENTITY(1,1) PRIMARY KEY,
    CartId          INT NOT NULL,
    VariantId       INT NOT NULL,
    Quantity        INT NOT NULL DEFAULT 1,
    CONSTRAINT FK_CartItems_Carts FOREIGN KEY (CartId) REFERENCES Carts(CartId),
    CONSTRAINT FK_CartItems_Variants FOREIGN KEY (VariantId) REFERENCES ProductVariants(VariantId)
);
GO

CREATE TABLE DiscountCodes (
    DiscountCodeId  INT IDENTITY(1,1) PRIMARY KEY,
    Code            NVARCHAR(50) NOT NULL UNIQUE,
    DiscountType    NVARCHAR(20) NOT NULL CHECK (DiscountType IN ('percent','fixed')),
    Value           DECIMAL(12,0) NOT NULL,
    MinOrderValue   DECIMAL(12,0) NULL,
    StartDate       DATETIME2 NULL,
    EndDate         DATETIME2 NULL,
    UsageLimit      INT NULL,
    CreatedBy       INT NOT NULL,
    CONSTRAINT FK_Discount_CreatedBy FOREIGN KEY (CreatedBy) REFERENCES Users(UserId)
);
GO

CREATE TABLE Orders (
    OrderId         INT IDENTITY(1,1) PRIMARY KEY,
    UserId          INT NOT NULL,
    AddressId       INT NOT NULL,
    DiscountCodeId  INT NULL,
    OrderStatus     NVARCHAR(20) NOT NULL DEFAULT 'pending'
                    CHECK (OrderStatus IN ('pending','confirmed','shipping','delivered','cancelled','returned')),
    PaymentStatus   NVARCHAR(20) NOT NULL DEFAULT 'unpaid'
                    CHECK (PaymentStatus IN ('unpaid','paid','refunded')),
    TotalAmount     DECIMAL(12,0) NOT NULL,
    CreatedAt       DATETIME2 NOT NULL DEFAULT SYSDATETIME(),
    CONSTRAINT FK_Orders_Users FOREIGN KEY (UserId) REFERENCES Users(UserId),
    CONSTRAINT FK_Orders_Addresses FOREIGN KEY (AddressId) REFERENCES Addresses(AddressId),
    CONSTRAINT FK_Orders_Discount FOREIGN KEY (DiscountCodeId) REFERENCES DiscountCodes(DiscountCodeId)
);
GO

CREATE TABLE OrderItems (
    OrderItemId       INT IDENTITY(1,1) PRIMARY KEY,
    OrderId           INT NOT NULL,
    VariantId         INT NOT NULL,
    Quantity          INT NOT NULL,
    PriceAtPurchase   DECIMAL(12,0) NOT NULL,
    CONSTRAINT FK_OrderItems_Orders FOREIGN KEY (OrderId) REFERENCES Orders(OrderId),
    CONSTRAINT FK_OrderItems_Variants FOREIGN KEY (VariantId) REFERENCES ProductVariants(VariantId)
);
GO

/* ============================================================
   4. PAYMENT (PayOS) & ĐỔI TRẢ
   ============================================================ */

CREATE TABLE Payments (
    PaymentId       INT IDENTITY(1,1) PRIMARY KEY,
    OrderId         INT NOT NULL,
    Amount          DECIMAL(12,0) NOT NULL,
    PaymentMethod   NVARCHAR(50) NOT NULL DEFAULT 'PayOS',
    TransactionId   NVARCHAR(100) NULL,
    Status          NVARCHAR(20) NOT NULL DEFAULT 'pending'
                    CHECK (Status IN ('pending','success','failed','refunded')),
    PaidAt          DATETIME2 NULL,
    CONSTRAINT FK_Payments_Orders FOREIGN KEY (OrderId) REFERENCES Orders(OrderId)
);
GO

CREATE TABLE ReturnRequests (
    ReturnId        INT IDENTITY(1,1) PRIMARY KEY,
    OrderId         INT NOT NULL,
    Reason          NVARCHAR(500) NOT NULL,
    Status          NVARCHAR(20) NOT NULL DEFAULT 'pending'
                    CHECK (Status IN ('pending','approved','rejected','refunded')),
    RefundAmount    DECIMAL(12,0) NULL,
    CreatedAt       DATETIME2 NOT NULL DEFAULT SYSDATETIME(),
    CONSTRAINT FK_Return_Orders FOREIGN KEY (OrderId) REFERENCES Orders(OrderId)
);
GO

/* ============================================================
   5. YÊU THÍCH & ĐÁNH GIÁ
   ============================================================ */

CREATE TABLE Favorites (
    FavoriteId      INT IDENTITY(1,1) PRIMARY KEY,
    UserId          INT NOT NULL,
    ProductId       INT NOT NULL,
    CreatedAt       DATETIME2 NOT NULL DEFAULT SYSDATETIME(),
    CONSTRAINT FK_Favorites_Users FOREIGN KEY (UserId) REFERENCES Users(UserId),
    CONSTRAINT FK_Favorites_Products FOREIGN KEY (ProductId) REFERENCES Products(ProductId),
    CONSTRAINT UQ_Favorites UNIQUE (UserId, ProductId)
);
GO

CREATE TABLE Reviews (
    ReviewId        INT IDENTITY(1,1) PRIMARY KEY,
    UserId          INT NOT NULL,
    ProductId       INT NOT NULL,
    OrderItemId     INT NOT NULL,
    Rating          INT NOT NULL CHECK (Rating BETWEEN 1 AND 5),
    Comment         NVARCHAR(1000) NULL,
    CreatedAt       DATETIME2 NOT NULL DEFAULT SYSDATETIME(),
    CONSTRAINT FK_Reviews_Users FOREIGN KEY (UserId) REFERENCES Users(UserId),
    CONSTRAINT FK_Reviews_Products FOREIGN KEY (ProductId) REFERENCES Products(ProductId),
    CONSTRAINT FK_Reviews_OrderItems FOREIGN KEY (OrderItemId) REFERENCES OrderItems(OrderItemId)
);
GO

/* ============================================================
   6. AI RECOMMENDATION
   ============================================================ */

CREATE TABLE UserBehaviorLogs (
    LogId           BIGINT IDENTITY(1,1) PRIMARY KEY,
    UserId          INT NULL,               -- NULL nếu là Guest
    SessionId       NVARCHAR(100) NULL,      -- dùng để track Guest ẩn danh
    ProductId       INT NOT NULL,
    ActionType      NVARCHAR(20) NOT NULL
                    CHECK (ActionType IN ('view','search','click','add_to_cart','favorite','purchase')),
    DurationSeconds INT NULL,
    CreatedAt       DATETIME2 NOT NULL DEFAULT SYSDATETIME(),
    CONSTRAINT FK_Behavior_Users FOREIGN KEY (UserId) REFERENCES Users(UserId),
    CONSTRAINT FK_Behavior_Products FOREIGN KEY (ProductId) REFERENCES Products(ProductId)
);
GO
CREATE INDEX IX_Behavior_User ON UserBehaviorLogs(UserId, CreatedAt);
CREATE INDEX IX_Behavior_Session ON UserBehaviorLogs(SessionId, CreatedAt);
CREATE INDEX IX_Behavior_Product ON UserBehaviorLogs(ProductId);
GO

CREATE TABLE UserPreferences (
    UserId              INT PRIMARY KEY,
    PreferredCategories NVARCHAR(MAX) NULL,   -- JSON array
    PreferredPriceMin   DECIMAL(12,0) NULL,
    PreferredPriceMax   DECIMAL(12,0) NULL,
    PreferredColors     NVARCHAR(MAX) NULL,   -- JSON array
    PreferredSizes      NVARCHAR(MAX) NULL,   -- JSON array
    UpdatedAt           DATETIME2 NOT NULL DEFAULT SYSDATETIME(),
    CONSTRAINT FK_Preferences_Users FOREIGN KEY (UserId) REFERENCES Users(UserId)
);
GO

CREATE TABLE ProductSimilarity (
    ProductIdA      INT NOT NULL,
    ProductIdB      INT NOT NULL,
    SimilarityScore DECIMAL(5,4) NOT NULL,
    UpdatedAt       DATETIME2 NOT NULL DEFAULT SYSDATETIME(),
    PRIMARY KEY (ProductIdA, ProductIdB),
    CONSTRAINT FK_Similarity_A FOREIGN KEY (ProductIdA) REFERENCES Products(ProductId),
    CONSTRAINT FK_Similarity_B FOREIGN KEY (ProductIdB) REFERENCES Products(ProductId)
);
GO

CREATE TABLE Recommendations (
    RecommendationId INT IDENTITY(1,1) PRIMARY KEY,
    UserId           INT NULL,
    SessionId        NVARCHAR(100) NULL,
    ProductId        INT NOT NULL,
    Reason           NVARCHAR(20) NOT NULL
                     CHECK (Reason IN ('personalized','similar','bestseller')),
    Score            DECIMAL(5,4) NULL,
    CreatedAt        DATETIME2 NOT NULL DEFAULT SYSDATETIME(),
    CONSTRAINT FK_Recommend_Users FOREIGN KEY (UserId) REFERENCES Users(UserId),
    CONSTRAINT FK_Recommend_Products FOREIGN KEY (ProductId) REFERENCES Products(ProductId)
);
GO
CREATE INDEX IX_Recommend_User ON Recommendations(UserId, CreatedAt);
GO

/* ============================================================
   7. NOTIFICATION / EMAIL
   ============================================================ */

CREATE TABLE Notifications (
    NotificationId  INT IDENTITY(1,1) PRIMARY KEY,
    UserId          INT NOT NULL,
    Type            NVARCHAR(20) NOT NULL CHECK (Type IN ('order','promotion','otp')),
    Content         NVARCHAR(1000) NOT NULL,
    IsRead          BIT NOT NULL DEFAULT 0,
    CreatedAt       DATETIME2 NOT NULL DEFAULT SYSDATETIME(),
    CONSTRAINT FK_Notifications_Users FOREIGN KEY (UserId) REFERENCES Users(UserId)
);
GO

